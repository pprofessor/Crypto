# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database Configuration (Podman)
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=crypto_user
DB_PASSWORD=ChangeMe123!
DB_DATABASE=crypto_exchange
DB_SCHEMA=crypto

# TypeORM
TYPEORM_SYNCHRONIZE=false
TYPEORM_LOGGING=true

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=RedisPass123!

# JWT Configuration
JWT_SECRET=YourSuperSecretKeyForJWT123!ChangeThisInProduction
JWT_EXPIRATION=1d
REFRESH_TOKEN_SECRET=YourRefreshTokenSecret456!ChangeThisToo
REFRESH_TOKEN_EXPIRATION=7d

# Security
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug